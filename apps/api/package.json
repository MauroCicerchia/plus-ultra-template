{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": {
      "types": "./src/app.ts",
      "import": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "node --conditions=development --import tsx --watch src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.8",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
