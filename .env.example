# Browser-visible base URL for the API. Left as a relative path so the Vite dev
# proxy and the Vercel deployment both resolve it without extra configuration.
VITE_API_URL=/api

# Pooled Neon connection used by API runtime queries.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require

# Direct (unpooled) Neon connection used by Drizzle migration commands only.
# Migrations cannot run through a connection pooler.
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require
